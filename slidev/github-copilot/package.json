{
  "name": "slidev-theme-github-copilot",
  "version": "0.1.0",
  "type": "module",
  "description": "A Slidev theme inspired by GitHub Copilot's visual design",
  "keywords": [
    "slidev-theme",
    "slidev",
    "github-copilot",
    "dark-theme"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.11.4"
  },
  "devDependencies": {
    "@slidev/cli": "^52.11.4"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "dark",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": "Inter, Nunito Sans, sans-serif",
        "serif": "Roboto Slab, serif",
        "mono": "Fira Code, monospace"
      },
      "transition": "slide-left"
    }
  }
}